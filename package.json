{
  "name": "ballistics-frontend",
  "version": "1.0.0",
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "typecheck": "tsc -p tsconfig.json",
    "test": "npm run typecheck && jest --coverage",
    "test:e2e": "jest --config jest.e2e.config.cjs"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "roots": [
      "tests"
    ],
    "testMatch": [
      "**/*.test.js",
      "**/*.test.ts"
    ],
    "testPathIgnorePatterns": [
      "tests/e2e"
    ],
    "coverageDirectory": "coverage",
    "collectCoverageFrom": [
      "app/sw.js",
      "app/drag-csv.js",
      "app/ballistics.js",
      "app/tools.js",
      "app/url-state.js",
      "app/custom-rounds.js",
      "app/physics/engine.ts",
      "app/physics/engine-async.ts"
    ],
    "transform": {
      "^.+\\.[jt]s$": "babel-jest"
    },
    "moduleNameMapper": {
      "^chart\\.js$": "<rootDir>/tests/__mocks__/chart.js",
      "^virtual:bullet-catalog$": "<rootDir>/tests/__mocks__/bullet-catalog.js",
      "^virtual:physics-tables$": "<rootDir>/tests/__mocks__/physics-tables.js"
    },
    "coverageThreshold": {
      "global": {
        "branches": 100,
        "functions": 100,
        "lines": 100,
        "statements": 100
      }
    }
  },
  "dependencies": {
    "chart.js": "^4.6.1"
  },
  "overrides": {
    "@tootallnate/once": "3.0.1"
  },
  "devDependencies": {
    "@babel/core": "^8.0.0",
    "@babel/preset-env": "^8.0.7",
    "@babel/preset-typescript": "^8.0.7",
    "babel-jest": "^30.4.1",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "jest-puppeteer": "^11.0.0",
    "js-yaml": "^5.5.0",
    "puppeteer": "^25.17.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6"
  }
}
